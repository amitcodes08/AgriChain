# Root environment file — read by `docker compose` only.
#
#   cp .env.example .env
#
# Each service also has its own .env.example for running it outside Docker:
#   backend/.env.example  frontend/.env.example  ai-service/.env.example
#   contracts/.env.example

# ---- Frontend build --------------------------------------------------------
# Baked into the frontend image at build time because NEXT_PUBLIC_* values are
# inlined by Next.js. The browser calls the API directly, so this must be the
# URL *you* can reach — not the compose service name.
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---- Chain writes (optional) -----------------------------------------------
# Leave both blank for the first `docker compose up`. The API works fully
# off-chain and reports `chain.enabled: false` in every response.
#
# To turn on-chain minting on:
#   1. docker compose up --build
#   2. read the address from contracts/deployments/localhost.json
#   3. paste it below, uncomment the key, then:
#        docker compose up -d --force-recreate backend
CONTRACT_ADDRESS=

# Hardhat dev account #0 from the "test test test … junk" mnemonic. It is the
# contract deployer and holds every role, so it can write any status update.
# Public, well-known, and worthless — local development only.
# BACKEND_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

BACKEND_PRIVATE_KEY=
