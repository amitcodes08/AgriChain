# ---- Server ----------------------------------------------------------------
# Read by uvicorn when started via `uvicorn app.main:app --host $HOST --port $PORT`.
HOST=0.0.0.0
PORT=8000

# ---- Assessment tuning -----------------------------------------------------
# Largest photo the service will read, in bytes. Anything above returns 413.
MAX_UPLOAD_BYTES=8388608

# Score at or above which a batch is marked verified. Mirrors QUALITY_THRESHOLD
# in the backend and `qualityThreshold` in AgriSupplyChain.sol — change all three
# together or the three layers will disagree.
QUALITY_THRESHOLD=60
