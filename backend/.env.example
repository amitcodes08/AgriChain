# ---- Server ----------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ---- MongoDB ---------------------------------------------------------------
# Host is the service name from docker-compose; `docker compose up` replaces
# 127.0.0.1 with `mongo`.
MONGO_URI=

# ---- AI microservice -------------------------------------------------------
AI_SERVICE_URL=http://127.0.0.1:8000
AI_REQUEST_TIMEOUT_MS=15000

# ---- CORS ------------------------------------------------------------------
# Comma-separated list of origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000

# ---- Uploads ---------------------------------------------------------------
UPLOAD_MAX_BYTES=8388608

# ---- Chain bridge (optional) -----------------------------------------------
# Leave both values empty to run off-chain only — the API stays fully
# functional, it just skips minting and status writes on chain.
#
# To enable: `docker compose up -d chain` then copy the deployed address from
# `contracts/deployments/localhost.json` (or read it from the chain logs) and
# set the private key of the deployer (Hardhat account #0):
#
#   CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
#   BACKEND_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
CONTRACT_ADDRESS=
BACKEND_PRIVATE_KEY=

# Where to read the deployed address + ABI from. Unset, the API looks in
# src/contracts/AgriSupplyChain.json (written by contracts/scripts/deploy.ts) and
# then ../contracts/deployments/localhost.json.
# CONTRACT_ABI_PATH=
