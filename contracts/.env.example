# ---- Local chain -----------------------------------------------------------
# RPC the `localhost` network targets for deploy:local / seed:local.
RPC_URL=http://127.0.0.1:8545

# Mnemonic the in-process Hardhat node derives its 10 funded accounts from.
# The default below is the standard Hardhat dev mnemonic — deterministic, so the
# backend and frontend can hardcode demo addresses. Never use it for real funds.
# DEV_MNEMONIC="test test test test test test test test test test test junk"

# ---- Role wiring at deploy time --------------------------------------------
# Optional. Unset, deploy.ts grants the roles to signers #1/#2/#3 of the node.
# FARMER_ADDRESS=
# AI_VERIFIER_ADDRESS=
# DISTRIBUTOR_ADDRESS=

# ---- Public testnet / mainnet ----------------------------------------------
# Only needed for `npm run deploy:amoy`. Use a throwaway key with test MATIC.
# DEPLOYER_PRIVATE_KEY=
# AMOY_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
# POLYGON_RPC_URL=https://polygon-rpc.com
