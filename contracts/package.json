{
  "name": "agrichain-contracts",
  "version": "1.0.0",
  "private": true,
  "description": "AgriChain Trace — Solidity smart contracts (batch NFTs, quality attestations, escrow payments)",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "node": "hardhat node --hostname 0.0.0.0",
