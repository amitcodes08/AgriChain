# Base URL of the AgriChain API. `/api` is appended by lib/api.ts.
#
# NEXT_PUBLIC_* values are inlined at build time, so changing this after a
# production build requires a rebuild — not just a restart.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional: shown in the header's network badge and used by the on-chain links.
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_CHAIN_ID=31337
